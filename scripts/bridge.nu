#!/usr/bin/env nu
# ──────────────────────────────────────────────────────────────────────────────
# Bitwig MCP — the Bitwig bridge extension (bitwig-bridge/)
# ──────────────────────────────────────────────────────────────────────────────
# Builds the Java extension with plain javac + jar (no Gradle, no dependencies):
# downloads Bitwig's extension API jar once (checksum pinned), generates
# BuildInfo.java (version from Cargo.toml, protocol from protocol.schema.json),
# compiles for Java 17 and packs target/bridge/bitwig-mcp-rs.bwextension.
#
# Usage:
#   nu scripts/bridge.nu build      # → target/bridge/bitwig-mcp-rs.bwextension
#   nu scripts/bridge.nu test       # plain-Java unit tests
#   nu scripts/bridge.nu install    # build + copy into Bitwig's Extensions folder
#   nu scripts/bridge.nu check      # build + test (quality gate); without javac: skipped
#                                   # locally, an error in CI
#   nu scripts/bridge.nu package --out dist   # release asset + .sha256
# ──────────────────────────────────────────────────────────────────────────────

use version.nu [cargo_version]

export const API_VERSION = 25
export const API_SHA256 = "842b1a05a1b29b17c4440cb3609c102953e3a0d28be910e743bce6aa2a38d1b6" # gitleaks:allow (checksum of a public jar)
export const ARTIFACT = "bitwig-mcp-rs.bwextension"
const PKG = "io/github/sorinirimies/bitwigmcp"

# Maven URL of Bitwig's extension API jar.
export def api_url [version: int]: nothing -> string {
    $"https://maven.bitwig.com/com/bitwig/extension-api/($version)/extension-api-($version).jar"
}

# File name of the release asset for a version.
export def asset_name [version: string]: nothing -> string {
    $"bitwig-mcp-rs-bridge-($version).bwextension"
}

# What to do without javac: CI must build the extension, a developer may skip it.
export def missing_javac [ci: bool]: nothing -> string {
    if $ci { "fail" } else { "skip" }
}

# Where Bitwig looks for extensions on each OS.
export def extensions_dir [os: string, home: string]: nothing -> string {
    match $os {
        "linux" => ($home | path join "Bitwig Studio" "Extensions"),
        "macos" | "windows" => ($home | path join "Documents" "Bitwig Studio" "Extensions"),
        _ => (error make {msg: $"unsupported OS: ($os)"}),
    }
}

# Java source carrying the build's version and protocol number.
export def build_info [version: string, protocol: int]: nothing -> string {
    if ($version !~ '^\d+\.\d+\.\d+') { error make {msg: $"not a version: ($version)"} }
    [
        "package io.github.sorinirimies.bitwigmcp;"
        ""
        "/** Generated by scripts/bridge.nu; do not edit. */"
        "final class BuildInfo"
        "{"
        $"   static final String VERSION = \"($version)\";"
        $"   static final int PROTOCOL = ($protocol);"
        ""
        "   private BuildInfo()"
        "   {"
        "   }"
        "}"
        ""
    ] | str join "\n"
}

# The protocol version recorded in the generated schema.
export def schema_protocol [schema: record]: nothing -> int {
    let v = ($schema | get -o protocol_version)
    if $v == null { error make {msg: "protocol.schema.json has no protocol_version"} }
    $v
}

def root []: nothing -> string { $env.FILE_PWD | path join ".." | path expand }

def api_jar []: nothing -> string {
    let dir = (root | path join "target" "bridge")
    mkdir $dir
    let jar = ($dir | path join $"extension-api-($API_VERSION).jar")
    if not ($jar | path exists) {
        print -e $"downloading Bitwig extension API ($API_VERSION)…"
        http get --raw (api_url $API_VERSION) | save --raw --force $jar
    }
    let sum = (open --raw $jar | hash sha256)
    if $sum != $API_SHA256 {
        rm $jar
        error make {msg: $"checksum mismatch for the extension API jar: ($sum)"}
    }
    $jar
}

def "main build" []: nothing -> nothing {
    let r = (root)
    let out = ($r | path join "target" "bridge")
    let classes = ($out | path join "classes")
    let gen = ($out | path join "gen")
    rm -rf $classes $gen
    mkdir $classes ($gen | path join $PKG)
    let version = (cargo_version (open ($r | path join "Cargo.toml")))
    let protocol = (schema_protocol (open ($r | path join "bitwig-bridge" "protocol.schema.json")))
    build_info $version $protocol | save --force ($gen | path join $PKG "BuildInfo.java")
    let sources = (glob ($r | path join "bitwig-bridge" "src" "**" "*.java")) ++ (glob ($gen | path join "**" "*.java"))
    let jar = (api_jar)
    ^javac --release 17 -Xlint:all -Werror -encoding UTF-8 -cp $jar -d $classes ...$sources
    cp -r ($r | path join "bitwig-bridge" "resources" "META-INF") $classes
    let artifact = ($out | path join $ARTIFACT)
    rm -f $artifact
    ^jar --create --file $artifact -C $classes .
    print -e $"✅ built ($artifact) \(v($version), protocol ($protocol)\)"
    print $"artifact=($artifact)"
}

def "main test" []: nothing -> nothing {
    let r = (root)
    let out = ($r | path join "target" "bridge" "test-classes")
    rm -rf $out
    mkdir $out
    let sources = [
        ($r | path join "bitwig-bridge" "src" $PKG "Json.java")
        ($r | path join "bitwig-bridge" "test" $PKG "JsonTest.java")
    ]
    ^javac --release 17 -Xlint:all -Werror -encoding UTF-8 -d $out ...$sources
    ^java -ea -cp $out io.github.sorinirimies.bitwigmcp.JsonTest
}

def "main package" [--out: path = "dist"]: nothing -> nothing {
    main build
    let r = (root)
    let version = (cargo_version (open ($r | path join "Cargo.toml")))
    mkdir $out
    let asset = (asset_name $version)
    let dest = ($out | path join $asset)
    cp ($r | path join "target" "bridge" $ARTIFACT) $dest
    let sum = (open --raw $dest | hash sha256)
    $"($sum)  ($asset)\n" | save --force $"($dest).sha256"
    print -e $"📦 ($dest)"
}

def "main install" []: nothing -> nothing {
    main build
    let os = ($nu.os-info.name)
    let home = ($env | get -o HOME | default ($env | get -o USERPROFILE))
    let dir = (extensions_dir $os $home)
    mkdir $dir
    cp (root | path join "target" "bridge" $ARTIFACT) $dir
    print -e $"✅ installed into ($dir)"
    print -e "   Bitwig: Settings → Controllers → Add controller → bitwig-mcp-rs → MCP bridge"
}

def "main check" []: nothing -> nothing {
    if (which javac | is-empty) {
        if (missing_javac ($env | get -o CI | is-not-empty)) == "fail" {
            error make {msg: "javac not found: CI must build the Bitwig extension (install a JDK 17+)"}
        }
        print -e "⚠ javac not found: skipping the bridge build and tests"
        return
    }
    main build
    main test
}

def main [] {
    print -e "usage: nu scripts/bridge.nu build | test | install | check | package [--out dir]"
}
